# ===================================================
# ResumeMatch AI Configuration
# ===================================================

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# Optional AI / LLM API Keys
# If not provided, ResumeMatch AI runs seamlessly using its built-in
# NLP & Semantic Fallback Engine (Demo Mode) with zero API costs.
OPENAI_API_KEY=
GEMINI_API_KEY=

# LLM Model Preferences (if using OpenAI / Gemini)
# Default OpenAI model: gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini
# Default Gemini model: gemini-1.5-flash
GEMINI_MODEL=gemini-1.5-flash

# Application Database
DATABASE_PATH=app_data.db

# Max Upload Size in Megabytes (default 10 MB)
MAX_UPLOAD_SIZE_MB=10

# Supabase Cloud Database Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-publishable-or-anon-key
