{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run ResumeMatch AI Server",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "Uvicorn running on (http://127.0.0.1:8000)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ]
}
